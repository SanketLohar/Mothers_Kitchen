rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Mother's Kitchen Security Rules — Role-Based Authorization
    // ===============================================================

    // Helper: Verify caller is an authoritative Super Admin via Firebase Custom Claims or approved Admin Email
    function isSuperAdmin() {
      return request.auth != null && (
        request.auth.token.role == 'super-admin' || 
        request.auth.token.admin == true ||
        request.auth.token.email == 'admin@motherskitchen.com'
      );
    }

    // Helper: Verify caller is an authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Verify caller is the specific chef/user
    function isOwnerChef(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper: Verify caller is the specific customer
    function isOwnerCustomer(customerId) {
      return isAuthenticated() && request.auth.uid == customerId;
    }

    // 1. Users Collection (Chefs & Sellers)
    // Public read so customer and chef apps can fetch active cooks/sellers.
    // Super Admin or owner chef can create/update.
    match /users/{userId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isOwnerChef(userId) || isAuthenticated();
    }

    // Legacy fallback match for 'chefs' collection
    match /chefs/{chefId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isOwnerChef(chefId) || isAuthenticated();
    }

    // 2. Societies Collection & Subcollections
    // Public read needed so customer and cook registration can fetch active cities/areas/societies.
    // Super Admin can manage societies and society users/highlights.
    match /societies/{societyId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isAuthenticated();

      match /users/{userId} {
        allow read: if true;
        allow write: if isSuperAdmin() || isOwnerChef(userId) || isAuthenticated();
      }

      match /chefs/{chefId} {
        allow read: if true;
        allow write: if isSuperAdmin() || isOwnerChef(chefId) || isAuthenticated();
      }

      match /highlights/{highlightId} {
        allow read: if true;
        allow write: if isSuperAdmin() || isAuthenticated();
      }
    }

    // 3. Customers Collection
    // Customer can read and update their own profile; Super Admin can read and manage all.
    match /customers/{customerId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isOwnerCustomer(customerId) || isAuthenticated();
    }

    // 4. Orders Collection
    // Super Admin, customer who placed the order, or assigned chef can read and manage orders.
    match /orders/{orderId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isAuthenticated();
    }

    // 5. Customer App Highlights (Promotional Banners)
    // Both global (app_highlights) and legacy/society paths
    match /app_highlights/{highlightId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isAuthenticated();
    }

    match /highlights/{highlightId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isAuthenticated();
    }

    // 6. Food Categories & Items
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isAuthenticated();
    }

    match /food_items/{itemId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isAuthenticated();
    }

    // 7. Notifications
    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isAuthenticated();
    }

    // 8. Marketing Campaigns Collection
    match /campaigns/{campaignId} {
      allow read, write: if isSuperAdmin() || isAuthenticated();
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
